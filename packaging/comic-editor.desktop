[Desktop Entry]
Type=Application
Name=Comic Editor
GenericName=Comic Library Manager
Comment=Manage, tag and compress CBZ/CBR comics
# @BIN@ and @ICON@ are replaced with installed paths by install.sh. A full
# icon path avoids depending on the desktop's (often stale) icon cache.
Exec=@BIN@
Icon=@ICON@
Terminal=false
Categories=Graphics;
Keywords=comic;comics;cbz;cbr;comicrack;comicinfo;comicvine;metadata;avif;
StartupWMClass=comic-editor
